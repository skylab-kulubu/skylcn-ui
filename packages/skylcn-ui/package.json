{
  "name": "@skylab-kulubu/skylcn-ui",
  "version": "0.0.0",
  "description": "SKY LAB web ürünlerinin ortak tasarım sistemi: token'lar, tema ve bileşenler.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./data-table": {
      "types": "./dist/data-table/index.d.ts",
      "import": "./dist/data-table/index.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react-day-picker": "^10.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skylab-kulubu/skylcn-ui.git",
    "directory": "packages/skylcn-ui"
  },
  "keywords": [
    "skylab",
    "design-system",
    "base-ui",
    "shadcn",
    "tailwindcss"
  ],
  "homepage": "https://github.com/skylab-kulubu/skylcn-ui#readme",
  "bugs": {
    "url": "https://github.com/skylab-kulubu/skylcn-ui/issues"
  }
}
