{
  "name": "skylcn-ui-workspace",
  "private": true,
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter docs dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @skylab-kulubu/skylcn-ui build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
